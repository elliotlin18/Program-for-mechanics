# ----------------------------------------------------------------------------
# Trygg Ekonomi — environment
# Copy to .env and fill in. Never commit .env. Secrets live in a secret manager
# in production, never in the repo.
# ----------------------------------------------------------------------------

# Database (Postgres). docker-compose.yml provides a local one matching this URL.
DATABASE_URL="postgresql://trygg:trygg@localhost:5432/trygg_ekonomi?schema=public"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32-byte base64 key used for AES-256-GCM encryption-at-rest of sensitive fields
# (account numbers, balances, transaction payees/descriptions).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# 32-byte base64 secret used to sign session cookies (HMAC).
# Generate the same way as above.
SESSION_SECRET=""

# Provider mode: "mock" runs fully locally with no external calls (default for dev).
# "live" uses the real BankID broker + Tink integrations below.
PROVIDER_MODE="mock"

# BankID via broker (Criipto or Signicat) — OIDC. Use test credentials in dev.
BANKID_BROKER_CLIENT_ID=""
BANKID_BROKER_CLIENT_SECRET=""
BANKID_BROKER_ISSUER_URL=""
BANKID_BROKER_REDIRECT_URI="http://localhost:3000/api/auth/bankid/callback"

# Tink (use SANDBOX first) — https://console.tink.com
TINK_CLIENT_ID=""
TINK_CLIENT_SECRET=""
TINK_REDIRECT_URI="http://localhost:3000/api/tink/callback"
TINK_WEBHOOK_SECRET=""

# Notifications (email/SMS provider of choice). In mock mode these are logged only.
NOTIFY_API_KEY=""
NOTIFY_FROM="trygg@example.com"
